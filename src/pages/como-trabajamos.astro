---
// Cómo trabajamos (CP1.2): sells the call and shows how clients are looked after. A statement that lights
// up with the scroll, the process as a scroll roadmap (call + four contract stages, with what you approve,
// pay and how we look after you), the commitments, the contract summary and the FAQ. The closing call to
// action lives in the last section (no violet band, ADR-010).
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import CTA from '../components/CTA.astro';
import CtaBlock from '../components/CtaBlock.astro';
import Statement from '../components/Statement.astro';
import Roadmap from '../components/Roadmap.astro';
import Capabilities from '../components/Capabilities.astro';
import FAQ from '../components/FAQ.astro';
import { href } from '../i18n/routes';
import { t } from '../i18n/ui';
import { rich } from '../lib/rich';
import { breadcrumbJsonLd, faqJsonLd } from '../lib/jsonld';

const lang = 'es';
const page = await getEntry('pages', 'es/como-trabajamos');
if (!page) throw new Error('Missing src/content/pages/es/como-trabajamos.yaml');
const c = page.data as any;
const ui = t(lang);
const site = Astro.site!;
const crumbs = breadcrumbJsonLd([
  { name: ui.breadcrumbHome, url: new URL(href('inicio', lang), site).href },
  { name: c.hero.eyebrow, url: new URL(href('como', lang), site).href },
]);
---

<Layout lang={lang} route="como" title={c.title} description={c.description} jsonLd={[crumbs, faqJsonLd(c.faq.items, lang)]}>
  <section class="section hero" aria-labelledby="hero-title">
    <div class="bg-grid hero__grid" aria-hidden="true"></div>
    <div class="container">
      <span class="eyebrow">{c.hero.eyebrow}</span>
      <h1 id="hero-title" set:html={rich(c.hero.title, lang)} />
      <p class="lead" set:html={rich(c.hero.lead, lang)} />
      <div class="hero__actions"><CTA lang={lang} location="como-hero" /></div>
      <p class="hero__note muted" set:html={rich(c.hero.ctaNote, lang)} />
      <p class="hero__note muted" set:html={rich(c.hero.contract, lang)} />
      <nav class="toc" aria-labelledby="toc-title">
        <p class="toc__title" id="toc-title">{ui.onThisPage}</p>
        <ul>
          <li><a href="#proceso">{c.roadmap.eyebrow}</a></li>
          <li><a href="#cuidamos">{c.care.eyebrow}</a></li>
          {c.sections.map((s: any) => <li><a href={`#${s.id}`}>{s.nav}</a></li>)}
          <li><a href="#preguntas">{c.faq.eyebrow}</a></li>
        </ul>
      </nav>
    </div>
  </section>

  <section class="section theme-light section--statement" aria-label={c.roadmap.eyebrow}>
    <div class="container">
      <Statement text={c.statement} wide />
    </div>
  </section>

  <Section lang={lang} id="proceso" eyebrow={c.roadmap.eyebrow} title={c.roadmap.title} lead={c.roadmap.lead}>
    <Roadmap lang={lang} copy={c.roadmap} />
  </Section>

  <Section lang={lang} theme="light" id="cuidamos" eyebrow={c.care.eyebrow} title={c.care.title}>
    <Capabilities lang={lang} items={c.care.items} />
  </Section>

  <Section lang={lang} id="detalles" eyebrow={c.details.eyebrow} title={c.details.title}>
    <div class="doc">
      {
        c.sections.map((s: any) => (
          <section id={s.id} aria-labelledby={`${s.id}-title`}>
            <h3 id={`${s.id}-title`} set:html={rich(s.title, lang)} />
            <div class="doc__body">
              {s.body?.map((p: string) => <p set:html={rich(p, lang)} />)}
              {s.list && (
                <ul class="check-list">
                  {s.list.map((li: string) => <li set:html={rich(li, lang)} />)}
                </ul>
              )}
              {s.ordered && (
                <ol>
                  {s.ordered.map((li: string) => <li set:html={rich(li, lang)} />)}
                </ol>
              )}
              {s.after?.map((p: string) => <p set:html={rich(p, lang)} />)}
              {s.columns && (
                <ul class="card-grid card-grid--2" role="list">
                  {s.columns.map((col: any) => (
                    <li class="card">
                      <h4 class="card__title">{col.title}</h4>
                      <ul class="check-list">
                        {col.list.map((li: string) => <li set:html={rich(li, lang)} />)}
                      </ul>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </section>
        ))
      }
    </div>
  </Section>

  <Section lang={lang} theme="light" id="preguntas" eyebrow={c.faq.eyebrow} title={c.faq.title}>
    <FAQ lang={lang} items={c.faq.items} />
    <CtaBlock lang={lang} title={c.cta.title} note={c.cta.text} />
  </Section>
</Layout>

<style>
  .section--statement { padding-block: var(--space-10); }
</style>
