---
// Aviso de privacidad integral (Q2, 2025 LFPDPPP). Linked from the footer and from the contact form's
// consent. The text lives in YAML; its blanks (lawyer review, virtual office address) block production.
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import LegalDoc from '../components/LegalDoc.astro';
import { href } from '../i18n/routes';
import { t } from '../i18n/ui';
import { breadcrumbJsonLd } from '../lib/jsonld';

const lang = 'es';
const page = await getEntry('pages', 'es/aviso-de-privacidad');
if (!page) throw new Error('Missing src/content/pages/es/aviso-de-privacidad.yaml');
const c = page.data as any;
const ui = t(lang);
const site = Astro.site!;
const crumbs = breadcrumbJsonLd([
  { name: ui.breadcrumbHome, url: new URL(href('inicio', lang), site).href },
  { name: c.hero.eyebrow, url: new URL(href('aviso', lang), site).href },
]);
---

<Layout lang={lang} route="aviso" title={c.title} description={c.description} jsonLd={[crumbs]}>
  <LegalDoc lang={lang} c={c} />
</Layout>
