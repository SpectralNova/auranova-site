---
// PREVIEW ONLY: never built in production (getStaticPaths returns nothing), excluded from the sitemap.
// CP1.2 options for David, side by side: Q34 home-hero animation, Q35 service-illustration style.
// Picking one is a one-line change:
//   hero animation       → `hero.variant` in src/content/pages/es/inicio.yaml
//   illustration style   → `illustration` in src/content/pages/es/servicios.yaml
import type { GetStaticPaths } from 'astro';
import { getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import HeroWorks from '../../components/HeroWorks.astro';
import ServiceGrid from '../../components/ServiceGrid.astro';
import { PRODUCTION } from '../../lib/env';
import { rich } from '../../lib/rich';

export const getStaticPaths = (() => (PRODUCTION ? [] : [{ params: { slug: undefined } }])) satisfies GetStaticPaths;

const lang = 'es';
const home = (await getEntry('pages', 'es/inicio'))!.data as any;
const services = (await getEntry('pages', 'es/servicios'))!.data as any;

const heroes = [
  { id: 'a', name: 'Tu sitio atiende', text: 'Una página de negocio que recibe una cotización mientras llegan avisos: solicitud, cita y mensaje. Es la más directa: se entiende en un segundo qué hace tu sitio por ti.', recommended: true },
  { id: 'b', name: 'Tu sitio no cierra', text: 'Un teléfono que pasa del día a la noche y sigue recibiendo clientes a cualquier hora. Comunica que tu sitio trabaja aunque tú no estés.' },
  { id: 'c', name: 'Del clic al cliente', text: 'El camino completo en tres pasos: te buscan en Google, entran a tu sitio y te escriben. Explica el proceso, pero pide un poco más de atención.' },
] as const;
const styles = [
  { id: 'a', name: 'Plano bicolor', text: 'Ilustración plana en violeta y lima con contorno oscuro. Totalmente 2D, amigable y la más nítida en el tamaño de las tarjetas.', recommended: true },
  { id: 'b', name: 'Línea y acento', text: 'Trazo violeta de un solo grosor con acentos lima, de la misma familia que los íconos del sitio. La más limpia.' },
  { id: 'c', name: 'Degradado aura', text: 'Formas suaves con el degradado lima → violeta del logo. La más distintiva en tamaño grande, aunque en tarjetas chicas pierde nitidez.' },
] as const;
const current = { hero: home.hero.variant, illustration: services.illustration };
---

<Layout lang={lang} title="Opciones de diseño · AuraNova (vista previa)" description="Vista previa interna: opciones de animación e ilustración para elegir.">
  <section class="section hero" aria-labelledby="hero-title">
    <div class="bg-grid hero__grid" aria-hidden="true"></div>
    <div class="container">
      <span class="eyebrow">Vista previa interna · no se publica</span>
      <h1 id="hero-title">Opciones de diseño</h1>
      <p class="lead">Elige una animación para el inicio y un estilo de ilustración para los servicios. Cambiarlo en el sitio es una sola línea.</p>
      <p class="hero__note muted">En el sitio ahora: animación <strong>{current.hero.toUpperCase()}</strong> · ilustraciones <strong>{current.illustration.toUpperCase()}</strong></p>
    </div>
  </section>

  <section class="section" id="animacion" aria-labelledby="animacion-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Inicio</span>
        <h2 id="animacion-title">Animación del inicio: <span class="hl">tu sitio trabaja para ti</span></h2>
        <p class="lead">Las tres reemplazan a «Este sitio, medido», que ahora vive en Sitios web. Todas se pueden pausar y se quedan quietas si tu sistema pide menos movimiento.</p>
      </div>
      {
        heroes.map((h) => (
          <article class="opt" aria-labelledby={`hero-${h.id}`}>
            <header class="opt__head">
              <span class="tag">Opción {h.id.toUpperCase()}</span>
              {'recommended' in h && h.recommended && <span class="opt__pick">Recomendada</span>}
              <h3 id={`hero-${h.id}`}>{h.name}</h3>
              <p class="muted">{h.text}</p>
            </header>
            <div class="opt__hero">
              <div class="opt__copy">
                <span class="eyebrow">{home.hero.eyebrow}</span>
                <p class="opt__title" set:html={rich(home.hero.title, lang)} />
                <p class="muted" set:html={rich(home.hero.lead, lang)} />
              </div>
              <HeroWorks variant={h.id} copy={home.hero.works} />
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section theme-light" id="ilustraciones" aria-labelledby="ilustraciones-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Servicios</span>
        <h2 id="ilustraciones-title">Estilo de las ilustraciones</h2>
        <p class="lead">Las mismas seis ilustraciones en tres estilos 2D, ya en las tarjetas del inicio y de Servicios.</p>
      </div>
      {
        styles.map((s) => (
          <article class="opt" aria-labelledby={`style-${s.id}`}>
            <header class="opt__head">
              <span class="tag">Estilo {s.id.toUpperCase()}</span>
              {'recommended' in s && s.recommended && <span class="opt__pick">Recomendado</span>}
              <h3 id={`style-${s.id}`}>{s.name}</h3>
              <p class="muted">{s.text}</p>
            </header>
            <ServiceGrid lang={lang} linkLabel={services.hero.linkLabel} style={s.id} />
          </article>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .opt + .opt { margin-top: var(--space-9); padding-top: var(--space-8); border-top: 1px solid var(--color-border); }
  .opt__head { display: grid; justify-items: start; gap: var(--space-2); max-width: var(--measure); margin-bottom: var(--space-6); }
  .opt__head h3 { margin: 0; font-size: var(--text-2xl); }
  .opt__head p { margin: 0; }
  .opt__pick { padding: var(--space-1) var(--space-3); border-radius: var(--radius-pill); background: var(--lime-1); color: var(--lime-7); font-size: var(--text-xs); font-weight: var(--weight-strong); letter-spacing: var(--tracking-caps); text-transform: uppercase; }
  .opt__hero {
    position: relative; display: grid; gap: var(--space-7); align-items: center; padding: var(--space-7) var(--space-6);
    overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-xl); background: var(--color-bg);
  }
  @media (min-width: 1024px) {
    .opt__hero { grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); }
  }
  .opt__title { margin: var(--space-4) 0; font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--text-3xl); line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }
</style>
