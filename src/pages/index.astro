---
// Home: only the essentials (David, CP1): what we do, how we do it, book a call.
// CP1.2: hero animation shows the site working for the client (options at /opciones/); no violet band.
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import CTA from '../components/CTA.astro';
import CtaBlock from '../components/CtaBlock.astro';
import HeroWorks from '../components/HeroWorks.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import ProcessTabs from '../components/ProcessTabs.astro';
import { href } from '../i18n/routes';
import { rich } from '../lib/rich';

const lang = 'es';
const page = await getEntry('pages', 'es/inicio');
if (!page) throw new Error('Missing src/content/pages/es/inicio.yaml');
const c = page.data as any;
---

<Layout lang={lang} route="inicio" title={c.title} description={c.description}>
  <section class="section hero hero--split" aria-labelledby="hero-title">
    <div class="bg-grid hero__grid" aria-hidden="true"></div>
    <div class="container">
      <div class="hero__copy">
        <span class="eyebrow">{c.hero.eyebrow}</span>
        <h1 id="hero-title" set:html={rich(c.hero.title, lang)} />
        <p class="lead" set:html={rich(c.hero.lead, lang)} />
        <div class="hero__actions">
          <CTA lang={lang} location="hero" />
          <a class="btn btn--secondary" href={href('servicios', lang)}>{c.hero.secondary}</a>
        </div>
        <p class="hero__note muted" set:html={rich(c.hero.note, lang)} />
      </div>
      <HeroWorks variant={c.hero.variant} copy={c.hero.works} />
    </div>
  </section>

  <Section lang={lang} theme="light" id="servicios" eyebrow={c.services.eyebrow} title={c.services.title} lead={c.services.lead}>
    <ServiceGrid lang={lang} linkLabel={c.services.linkLabel} />
  </Section>

  <Section lang={lang} id="proceso" eyebrow={c.process.eyebrow} title={c.process.title} lead={c.process.lead} center>
    <ProcessTabs lang={lang} copy={c.process} />
    <CtaBlock lang={lang} location="proceso" note={c.process.ctaNote} center />
  </Section>
</Layout>
