---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { href, type RouteKey } from '../i18n/routes';
import { rich } from '../lib/rich';
import { PRODUCTION } from '../lib/env';

const lang = 'es';
const page = await getEntry('pages', 'es/404');
if (!page) throw new Error('Missing src/content/pages/es/404.yaml');
const c = page.data as any;
---

<Layout lang={lang} title={c.title} description={c.description}>
  <section class="section hero" aria-labelledby="hero-title">
    <div class="bg-grid hero__grid" aria-hidden="true"></div>
    <div class="container">
      <span class="eyebrow">{c.eyebrow}</span>
      <h1 id="hero-title" set:html={rich(c.heading, lang)} />
      <p class="lead">{c.text}</p>
      {!PRODUCTION && <p set:html={rich(c.previewNote, lang)} />}
      <div class="hero__actions"><a class="btn btn--primary" href={href('inicio', lang)}>{c.home}</a></div>
      <ul class="not-found__links">
        {
          c.links.map((l: { label: string; route: string }) => (
            <li>
              <a class="btn btn--ghost" href={href(l.route as RouteKey, lang)}>
                {l.label} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
