---
// Only published, permitted work (Q12): Vista Consulting once its OK in writing arrives; LOGOS and FERREMAG once
// published. While no project is visible, the page shows its holding text, is noindex and leaves the nav,
// the footer and the sitemap (ADR-021).
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import CtaBlock from '../components/CtaBlock.astro';
import CaseCard from '../components/CaseCard.astro';
import { href } from '../i18n/routes';
import { t } from '../i18n/ui';
import { rich } from '../lib/rich';
import { breadcrumbJsonLd } from '../lib/jsonld';
import { visibleProjects } from '../lib/projects';

const lang = 'es';
const page = await getEntry('pages', 'es/proyectos');
if (!page) throw new Error('Missing src/content/pages/es/proyectos.yaml');
const c = page.data as any;
const projects = await visibleProjects(lang);
const empty = projects.length === 0;
const hero = empty ? { ...c.hero, ...c.empty } : c.hero;
const site = Astro.site!;
const crumbs = breadcrumbJsonLd([
  { name: t(lang).breadcrumbHome, url: new URL(href('inicio', lang), site).href },
  { name: c.hero.eyebrow, url: new URL(href('proyectos', lang), site).href },
]);
---

<Layout lang={lang} route="proyectos" title={c.title} description={c.description} jsonLd={[crumbs]} noindex={empty}>
  <section class="section hero" aria-labelledby="hero-title">
    <div class="bg-grid hero__grid" aria-hidden="true"></div>
    <div class="container">
      <span class="eyebrow">{hero.eyebrow}</span>
      <h1 id="hero-title" set:html={rich(hero.title, lang)} />
      <p class="lead" set:html={rich(hero.lead, lang)} />
    </div>
  </section>

  <Section lang={lang} theme="light" id="lista" srTitle={c.hero.listTitle}>
    {!empty && <div class="case-list">{projects.map((p) => <CaseCard lang={lang} project={p} showDetails />)}</div>}
    <CtaBlock lang={lang} note={c.cta.note} />
  </Section>
</Layout>

<style>
  /* A longer headline than other pages (David, CP1.3): give it a wider line. */
  .hero h1 { max-width: 22ch; }
</style>
