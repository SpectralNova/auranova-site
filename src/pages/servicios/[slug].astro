---
// One page per service (src/content/services/es/*.yaml). CP1.2 (David): each page is its own world —
// a generated background in the hero, a coded signature demo, a scroll ticker of capabilities; the Sitios
// web page also shows this site's measured quality. Sections alternate light/dark automatically, so the
// optional ones (quality, tools, proof) never leave two equal themes side by side. No violet band: the
// closing call to action lives in the last section (ADR-010).
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import CTA from '../../components/CTA.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import CaseCard from '../../components/CaseCard.astro';
import Capabilities from '../../components/Capabilities.astro';
import CapTicker from '../../components/CapTicker.astro';
import ToolsGrid from '../../components/ToolsGrid.astro';
import FAQ from '../../components/FAQ.astro';
import MoreLink from '../../components/MoreLink.astro';
import HeroBackdrop from '../../components/HeroBackdrop.astro';
import ServiceDemo from '../../components/ServiceDemo.astro';
import ProcessLine from '../../components/ProcessLine.astro';
import QualityReport from '../../components/QualityReport.astro';
import { href, type RouteKey } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import { rich } from '../../lib/rich';
import { breadcrumbJsonLd, faqJsonLd } from '../../lib/jsonld';

export const getStaticPaths = (async () => {
  const services = await getCollection('services', (s) => s.id.startsWith('es/'));
  return services.map((service) => ({ params: { slug: service.data.route.split('/')[1] }, props: { service } }));
}) satisfies GetStaticPaths;

interface Props {
  service: CollectionEntry<'services'>;
}

const lang = 'es';
const { service } = Astro.props;
const s = service.data;
const route = s.route as RouteKey;
const c = s.page as any;
const shared = (await getEntry('pages', 'es/servicios'))!.data as any;
const projects = s.proof ? (await getCollection('projects', (p) => p.id.startsWith('es/'))).sort((a, b) => a.data.order - b.data.order) : [];
const ui = t(lang);
const site = Astro.site!;
const crumbs = breadcrumbJsonLd([
  { name: ui.breadcrumbHome, url: new URL(href('inicio', lang), site).href },
  { name: ui.servicesMenu, url: new URL(href('servicios', lang), site).href },
  { name: s.name, url: new URL(href(route, lang), site).href },
]);

const sections = ['demo', 'capabilities', c.quality && 'quality', 'includes', s.tools?.length && 'tools', 'process', projects.length && 'proof', 'price', 'faq'].filter(Boolean) as string[];
const theme = (key: string) => (sections.indexOf(key) % 2 === 0 ? 'light' : 'dark');
const slug = s.route.split('/')[1];
const demoCopy = { pause: shared.demoControls.pause, play: shared.demoControls.play, demo: c.demo.ui };
---

<Layout lang={lang} route={route} title={c.title} description={c.description} jsonLd={[faqJsonLd(c.faq.items, lang), crumbs]}>
  <section class="section hero hero--service" aria-labelledby="hero-title">
    <HeroBackdrop file={`bg/${s.art}.webp`} />
    <div class="container">
      <div class="hero__copy">
        <span class="eyebrow">{c.hero.eyebrow}</span>
        <h1 id="hero-title" set:html={rich(c.hero.title, lang)} />
        <p class="lead" set:html={rich(c.hero.lead, lang)} />
        <div class="hero__actions">
          <CTA lang={lang} location={`servicio-${slug}`} />
          <a class="btn btn--secondary" href="#incluye">{shared.heroSecondary}</a>
        </div>
      </div>
    </div>
  </section>

  <Section lang={lang} theme={theme('demo')} id="en-accion" eyebrow={c.demo.eyebrow} title={c.demo.title} lead={c.demo.lead} center>
    <div class="sd-scale">
      <ServiceDemo art={s.art} copy={demoCopy} />
    </div>
    {c.demo.note && <p class="demo-foot" set:html={rich(c.demo.note, lang)} />}
  </Section>

  <Section lang={lang} theme={theme('capabilities')} id="que-hacemos" eyebrow={c.capabilities.eyebrow} title={c.capabilities.title}>
    <CapTicker items={c.capabilities.items.map((i: { title: string }) => i.title)} />
    <Capabilities lang={lang} items={c.capabilities.items} />
    {
      c.note && (
        <div class="card callout">
          <h3 class="card__title" set:html={rich(c.note.title, lang)} />
          <p class="muted" set:html={rich(c.note.text, lang)} />
        </div>
      )
    }
  </Section>

  {
    c.quality && (
      <Section lang={lang} theme={theme('quality')} id="calidad" eyebrow={c.quality.eyebrow} title={c.quality.title} lead={c.quality.lead}>
        <QualityReport lang={lang} copy={c.quality} />
      </Section>
    )
  }

  <Section lang={lang} theme={theme('includes')} id="incluye" eyebrow={c.includes.eyebrow} title={c.includes.title} lead={c.includes.lead}>
    <ul class="card-grid card-grid--3" role="list">
      {
        c.includes.columns.map((col: any) => (
          <li class="card">
            <h3 class="card__title">{col.title}</h3>
            <ul class:list={['check-list', { 'check-list--no': col.negative }]}>
              {col.list.map((li: string) => (
                <li set:html={rich(li, lang)} />
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </Section>

  {
    s.tools?.length && (
      <Section lang={lang} theme={theme('tools')} id="herramientas" eyebrow={shared.tools.eyebrow} title={shared.tools.title}>
        <ToolsGrid slugs={s.tools} labels={shared.tools.items} />
      </Section>
    )
  }

  <Section lang={lang} theme={theme('process')} id="proceso" eyebrow={shared.process.eyebrow} title={shared.process.title}>
    <ProcessLine lang={lang} steps={shared.process.steps} />
    <MoreLink lang={lang} link={shared.process.link} />
  </Section>

  {
    projects.length > 0 && (
      <Section lang={lang} theme={theme('proof')} id="proyectos" eyebrow={shared.proof.eyebrow} title={shared.proof.title}>
        {projects.map((p) => (
          <CaseCard lang={lang} project={p} />
        ))}
      </Section>
    )
  }

  <Section lang={lang} theme={theme('price')} id="precio" eyebrow={shared.price.eyebrow} title={shared.price.title}>
    <div class="prose">{shared.price.text.map((p: string) => <p set:html={rich(p, lang)} />)}</div>
  </Section>

  <Section lang={lang} theme={theme('faq')} id="preguntas" eyebrow={c.faq.eyebrow} title={c.faq.title}>
    <FAQ lang={lang} items={c.faq.items} />
    <CtaBlock lang={lang} title={c.cta.title} note={c.cta.text} />
  </Section>
</Layout>

<style>
  .hero--service { display: flex; align-items: center; min-height: min(46rem, 92svh); padding-block: var(--space-9); }
  .hero--service .hero__copy { max-width: 38rem; }
  @media (max-width: 1023px) {
    .hero--service { display: block; min-height: 0; padding-top: min(50vw, 21rem); }
  }
</style>
