---
import { getCollection } from 'astro:content';
import { href, type RouteKey } from '../i18n/routes';
import type { Lang } from '../content/business';

interface Props {
  lang: Lang;
  linkLabel: string;
}

const { lang, linkLabel } = Astro.props;
const services = (await getCollection('services', (s) => s.id.startsWith(`${lang}/`))).sort((a, b) => a.data.order - b.data.order);
---

<ul class="card-grid card-grid--3" role="list">
  {
    services.map(({ data }) => {
      const route = data.route as RouteKey;
      return (
        <li class="card card--interactive service-card">
          <span class="tag">{data.kicker}</span>
          <h3 class="card__title">
            <a class="card__link" href={href(route, lang)}>
              {data.name}
            </a>
          </h3>
          <p class="muted">{data.summary}</p>
          <span class="service-card__more" aria-hidden="true">
            {linkLabel} →
          </span>
        </li>
      );
    })
  }
</ul>
