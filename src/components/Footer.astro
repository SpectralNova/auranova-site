---
import SocialLinks from './SocialLinks.astro';
import { business, factText, factValue, type Lang } from '../content/business';
import { href, isBuilt } from '../i18n/routes';
import { t } from '../i18n/ui';
import { rich } from '../lib/rich';
import { visibleProjects } from '../lib/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang);
const email = factValue(business.email, lang);
const year = new Date().getFullYear();
// Only pages that exist get a link (routes.ts `built`); the rest appear when their page is built.
const trustLinks = ui.footer.links.trust.filter(([key]) => isBuilt(key, lang));
// Proyectos only while a project is visible (ADR-021).
const hasProjects = (await visibleProjects(lang)).length > 0;
const siteLinks = ui.footer.links.site.filter(([key]) => isBuilt(key, lang) && (key !== 'proyectos' || hasProjects));
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a class="nav__logo" href={href('inicio', lang)}>
        <img src="/auranova-mark.svg" alt="" width="36" height="36" loading="lazy" />AuraNova
      </a>
      <p class="muted">{ui.footer.tagline}</p>
      <SocialLinks lang={lang} class="site-footer__social" />
    </div>
    <nav aria-label={ui.footer.site}>
      <h2 class="site-footer__title">{ui.footer.site}</h2>
      <ul>{siteLinks.map(([key, label]) => <li><a href={href(key, lang)}>{label}</a></li>)}</ul>
    </nav>
    {
      trustLinks.length > 0 && (
        <nav aria-label={ui.footer.trust}>
          <h2 class="site-footer__title">{ui.footer.trust}</h2>
          <ul>
            {trustLinks.map(([key, label]) => <li><a href={href(key, lang)}>{label}</a></li>)}
            <li><button class="site-footer__link" type="button" data-consent-open>{ui.consent.open}</button></li>
          </ul>
        </nav>
      )
    }
    <div>
      <h2 class="site-footer__title">{ui.footer.contact}</h2>
      <dl class="site-footer__contact">
        <dt>{ui.footer.email}</dt>
        <dd>{email ? <a href={`mailto:${email}`}>{email}</a> : <Fragment set:html={rich(factText(business.email, lang), lang)} />}</dd>
        <dt>{ui.footer.hours}</dt>
        <dd set:html={rich('{{horarioPie}}', lang)} />
        <dt>{ui.footer.location}</dt>
        <dd>{factText(business.location, lang)}</dd>
      </dl>
    </div>
  </div>
  <div class="container site-footer__legal">
    <p class="muted">© {year} AuraNova. {ui.footer.rights}</p>
  </div>
</footer>
