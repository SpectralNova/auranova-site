---
// Plataformas a la medida: "cada quien ve lo suyo". An admin panel lists users with roles; one client is
// selected, a permissions drawer slides in and its switches flip, and the change is saved. Illustrative.
import Icon from '../Icon.astro';
import DemoToggle from '../DemoToggle.astro';

interface Props {
  copy: any;
}

const { copy } = Astro.props;
const d = copy.demo;
---

<div class="svc-demo theme-dark pp" data-demo>
  <div class="pp__scene" aria-hidden="true">
    <div class="demo-window__bar">
      <span class="demo-window__dots"><span></span><span></span><span></span></span>
      <span class="demo-window__url pp__url"><Icon name="lock" size={12} />{d.url}</span>
      <span class="svc-demo__bar-end pp__me"><span class="pp__avatar pp__avatar--me"></span>{d.admin}</span>
    </div>
    <div class="pp__body">
      <nav class="pp__side">
        <span class="pp__nav is-on"><Icon name="users" size={16} /></span>
        <span class="pp__nav"><Icon name="layout-dashboard" size={16} /></span>
        <span class="pp__nav"><Icon name="calendar" size={16} /></span>
        <span class="pp__nav"><Icon name="file-text" size={16} /></span>
        <span class="pp__nav"><Icon name="settings" size={16} /></span>
      </nav>
      <div class="pp__main">
        <div class="pp__head">
          <strong>{d.title}</strong>
          <span class="pp__search"><Icon name="search" size={14} /><span class="mock-line"></span></span>
          <span class="pp__invite"><Icon name="plus" size={14} />{d.invite}</span>
        </div>
        <ul class="pp__rows">
          {
            d.users.map((u: any, i: number) => (
              <li class={`pp__row pp__row--${i + 1}`}>
                <span class:list={['pp__avatar', `pp__avatar--${i + 1}`]}></span>
                <span class="pp__who"><strong>{u.name}</strong><span class="mock-line mock-line--w70"></span></span>
                <span class:list={['pp__role', `pp__role--${u.tone}`]}>{u.role}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <aside class="pp__drawer">
        <p class="pp__drawer-title"><Icon name="shield-check" size={16} />{d.drawerTitle}</p>
        <ul class="pp__perms">
          {
            d.perms.map((p: any, i: number) => (
              <li class={`pp__perm pp__perm--${i + 1}`}>
                <span>{p.label}</span>
                {p.on ? (
                  <span class="pp__switch"><span class="pp__switch-on"></span><span class="pp__thumb"></span></span>
                ) : (
                  <span class="pp__lock"><Icon name="lock" size={14} /></span>
                )}
              </li>
            ))
          }
        </ul>
        <span class="pp__save">{d.save}</span>
      </aside>
    </div>
    <p class="demo-toast pp__toast">
      <span class="demo-toast__icon"><Icon name="shield-check" size={18} /></span>
      <span><strong>{d.toastTitle}</strong><small>{d.toastText}</small></span>
    </p>
  </div>
  <DemoToggle pause={copy.pause} play={copy.play} />
</div>

<style>
  .pp__url { flex: 0 1 auto; max-width: 16rem; }
  .pp__me { font-size: var(--text-xs); color: var(--color-text-muted); }
  .pp__body { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); min-height: 25rem; overflow: hidden; }
  @media (min-width: 768px) {
    .pp__body { grid-template-columns: auto minmax(0, 1fr); }
  }
  .pp__side { display: none; flex-direction: column; gap: var(--space-2); padding: var(--space-4) var(--space-3); border-right: 1px solid var(--color-border); }
  @media (min-width: 768px) {
    .pp__side { display: flex; }
  }
  .pp__nav { display: grid; place-items: center; width: var(--space-7); height: var(--space-7); border-radius: var(--radius-md); color: var(--color-text-muted); }
  .pp__nav.is-on { background: var(--color-surface-2); color: var(--lime-1); }
  .pp__main { padding: var(--space-5); }
  .pp__head { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-bottom: var(--space-4); }
  .pp__head strong { font-family: var(--font-heading); font-size: var(--text-lg); margin-right: auto; }
  .pp__search { display: inline-flex; align-items: center; gap: var(--space-2); width: 9rem; padding: var(--space-1) var(--space-3); border-radius: var(--radius-pill); background: var(--color-surface-2); color: var(--color-text-muted); }
  .pp__search .mock-line { flex: 1; }
  .pp__invite { display: inline-flex; align-items: center; gap: var(--space-1); padding: var(--space-1) var(--space-3); border-radius: var(--radius-pill); background: var(--lime-1); color: var(--lime-7); font-size: var(--text-xs); font-weight: var(--weight-strong); }
  .pp__rows { display: grid; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .pp__row { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: var(--space-3); padding: var(--space-3); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); font-size: var(--text-sm); }
  .pp__row::after { content: ""; position: absolute; inset: -1px; border: 1px solid var(--lime-1); border-radius: inherit; box-shadow: var(--glow-accent); opacity: 0; pointer-events: none; }
  .pp__who { display: grid; gap: var(--space-1); }
  .pp__avatar { width: var(--space-6); height: var(--space-6); border-radius: 50%; background: linear-gradient(135deg, var(--violet-3), var(--violet-5)); }
  .pp__avatar--2 { background: linear-gradient(135deg, var(--lime-1), var(--lime-3)); }
  .pp__avatar--3 { background: linear-gradient(135deg, var(--violet-2), var(--violet-4)); }
  .pp__avatar--4 { background: linear-gradient(135deg, var(--gray-2), var(--gray-4)); }
  .pp__avatar--me { width: var(--space-5); height: var(--space-5); }
  .pp__role { padding: var(--space-1) var(--space-3); border-radius: var(--radius-pill); font-size: var(--text-xs); font-weight: var(--weight-strong); white-space: nowrap; }
  .pp__role--admin { background: var(--violet-5); color: var(--violet-1); }
  .pp__role--team { background: var(--color-surface-2); color: var(--color-text); }
  .pp__role--client { background: color-mix(in oklab, var(--lime-1), transparent 82%); color: var(--lime-1); }
  .pp__drawer {
    position: absolute; top: var(--space-3); right: var(--space-3); bottom: var(--space-3); display: flex; flex-direction: column; gap: var(--space-4);
    width: min(19rem, 86%); padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--color-surface-2), transparent 4%); box-shadow: var(--shadow-lg);
    backdrop-filter: var(--nav-blur); -webkit-backdrop-filter: var(--nav-blur);
  }
  /* Phones: the drawer sits under the list instead of over it, so both stay readable. */
  @media (max-width: 767px) {
    .pp__drawer { position: relative; inset: auto; width: auto; margin: 0 var(--space-5) var(--space-5); }
    .pp__save { margin-top: var(--space-2); }
  }
  .pp__drawer-title { display: flex; align-items: center; gap: var(--space-2); margin: 0; font-weight: var(--weight-strong); }
  .pp__drawer-title :global(.icon) { color: var(--lime-1); }
  .pp__perms { display: grid; gap: var(--space-3); margin: 0; padding: 0; list-style: none; font-size: var(--text-sm); }
  .pp__perm { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); padding-bottom: var(--space-3); border-bottom: 1px solid var(--color-border); }
  .pp__switch { position: relative; flex: none; width: calc(var(--space-7) - var(--space-2)); height: var(--space-5); border-radius: var(--radius-pill); background: var(--gray-5); }
  .pp__switch-on { position: absolute; inset: 0; border-radius: inherit; background: var(--lime-1); }
  .pp__thumb { position: absolute; top: 2px; left: 2px; width: calc(var(--space-5) - var(--space-1)); aspect-ratio: 1; border-radius: 50%; background: var(--white); transform: translateX(calc(var(--space-7) - var(--space-2) - var(--space-5))); }
  .pp__lock { display: inline-grid; place-items: center; width: var(--space-6); height: var(--space-6); border-radius: 50%; background: var(--color-surface); color: var(--color-text-muted); }
  .pp__save { align-self: flex-start; margin-top: auto; padding: var(--space-2) var(--space-4); border-radius: var(--radius-pill); background: var(--lime-1); color: var(--lime-7); font-size: var(--text-sm); font-weight: var(--weight-strong); }
  .pp__toast { position: absolute; left: var(--space-5); bottom: var(--space-5); margin: 0; max-width: calc(100% - var(--space-9)); }

  @keyframes pp-r1 { 0%, 3% { opacity: 0; transform: translateY(var(--space-3)); } 7%, 92% { opacity: 1; transform: none; } 97%, 100% { opacity: 0; } }
  @keyframes pp-r2 { 0%, 7% { opacity: 0; transform: translateY(var(--space-3)); } 11%, 92% { opacity: 1; transform: none; } 97%, 100% { opacity: 0; } }
  @keyframes pp-r3 { 0%, 11% { opacity: 0; transform: translateY(var(--space-3)); } 15%, 92% { opacity: 1; transform: none; } 97%, 100% { opacity: 0; } }
  @keyframes pp-r4 { 0%, 15% { opacity: 0; transform: translateY(var(--space-3)); } 19%, 92% { opacity: 1; transform: none; } 97%, 100% { opacity: 0; } }
  @keyframes pp-pick { 0%, 25% { opacity: 0; } 28%, 90% { opacity: 1; } 94%, 100% { opacity: 0; } }
  @keyframes pp-drawer { 0%, 31% { opacity: 0; transform: translateX(110%); } 36%, 88% { opacity: 1; transform: none; } 93%, 100% { opacity: 0; transform: translateX(110%); } }
  @keyframes pp-on1 { 0%, 42% { opacity: 0; } 45%, 100% { opacity: 1; } }
  @keyframes pp-on2 { 0%, 49% { opacity: 0; } 52%, 100% { opacity: 1; } }
  @keyframes pp-thumb1 { 0%, 42% { transform: none; } 45%, 100% { transform: translateX(calc(var(--space-7) - var(--space-2) - var(--space-5))); } }
  @keyframes pp-thumb2 { 0%, 49% { transform: none; } 52%, 100% { transform: translateX(calc(var(--space-7) - var(--space-2) - var(--space-5))); } }
  @keyframes pp-lock1 { 0%, 56% { transform: scale(0.4); opacity: 0; } 59%, 100% { transform: none; opacity: 1; } }
  @keyframes pp-lock2 { 0%, 61% { transform: scale(0.4); opacity: 0; } 64%, 100% { transform: none; opacity: 1; } }
  @keyframes pp-save { 0%, 68% { transform: none; } 70% { transform: scale(0.9); } 72%, 100% { transform: none; } }
  @keyframes pp-toast { 0%, 72% { opacity: 0; transform: translateY(var(--space-4)); } 76%, 90% { opacity: 1; transform: none; } 95%, 100% { opacity: 0; } }
  @media (prefers-reduced-motion: no-preference) {
    .pp__row--1 { animation: pp-r1 var(--cycle) var(--ease-out) infinite both; }
    .pp__row--2 { animation: pp-r2 var(--cycle) var(--ease-out) infinite both; }
    .pp__row--3 { animation: pp-r3 var(--cycle) var(--ease-out) infinite both; }
    .pp__row--4 { animation: pp-r4 var(--cycle) var(--ease-out) infinite both; }
    .pp__row--3::after { animation: pp-pick var(--cycle) linear infinite both; }
    .pp__drawer { animation: pp-drawer var(--cycle) var(--ease-out) infinite both; }
    .pp__perm--1 .pp__switch-on { animation: pp-on1 var(--cycle) linear infinite both; }
    .pp__perm--2 .pp__switch-on { animation: pp-on2 var(--cycle) linear infinite both; }
    .pp__perm--1 .pp__thumb { animation: pp-thumb1 var(--cycle) var(--ease-out) infinite both; }
    .pp__perm--2 .pp__thumb { animation: pp-thumb2 var(--cycle) var(--ease-out) infinite both; }
    .pp__perm--3 .pp__lock { animation: pp-lock1 var(--cycle) var(--ease-out) infinite both; }
    .pp__perm--4 .pp__lock { animation: pp-lock2 var(--cycle) var(--ease-out) infinite both; }
    .pp__save { animation: pp-save var(--cycle) linear infinite both; }
    .pp__toast { animation: pp-toast var(--cycle) var(--ease-out) infinite both; }
  }
  /* Still frame (reduced motion): the third row selected, the drawer open, everything saved. */
  @media (prefers-reduced-motion: reduce) {
    .pp__row--3::after { opacity: 1; }
  }
</style>
