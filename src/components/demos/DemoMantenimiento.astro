---
// Mantenimiento y soporte: a terminal runs the routine checks (backup, updates, certificate, forms, speed)
// while the monitor shows the site's heartbeat and a 30-day strip. Sample data, labelled; no frequency or
// response time is promised here (plans are still pending, Q11).
import Icon from '../Icon.astro';
import DemoToggle from '../DemoToggle.astro';

interface Props {
  copy: any;
}

const { copy } = Astro.props;
const d = copy.demo;
const ecg = 'M0 30 L40 30 L48 30 L54 12 L60 46 L66 22 L72 30 L120 30 L160 30 L168 30 L174 12 L180 46 L186 22 L192 30 L240 30';
---

<div class="svc-demo theme-dark mt" data-demo>
  <div class="mt__scene" aria-hidden="true">
    <div class="demo-window__bar">
      <span class="demo-window__dots"><span></span><span></span><span></span></span>
      <span class="svc-demo__title"><Icon name="activity" size={14} />{d.title}</span>
      <span class="svc-demo__bar-end">
        <span class="mt__status"><span class="mt__dot"></span>{d.online}</span>
        <span class="demo-tag">{d.sample}</span>
      </span>
    </div>
    <div class="mt__body">
      <ol class="mt__term demo-mono">
        <li class="mt__line mt__line--0"><span class="mt__prompt">$</span> {d.command}</li>
        {
          d.checks.map((c: string, i: number) => (
            <li class={`mt__line mt__line--${i + 1}`}>
              <span class="mt__ok">✓</span> {c}
            </li>
          ))
        }
        <li class={`mt__line mt__line--${d.checks.length + 1} mt__done`}>
          <span class="mt__prompt">→</span> {d.done}<span class="mt__caret"></span>
        </li>
      </ol>
      <div class="mt__side">
        <div class="mt__card">
          <p class="mt__label">{d.uptimeTitle}</p>
          <div class="mt__ecg">
            <svg viewBox="0 0 240 60" preserveAspectRatio="none" class="mt__ecg-svg">
              <path d={ecg} />
            </svg>
          </div>
        </div>
        <div class="mt__card">
          <p class="mt__label">{d.daysTitle}</p>
          <div class="mt__days">{Array.from({ length: 30 }, (_, i) => <i style={`--i: ${i}`}></i>)}</div>
        </div>
        <div class="mt__card mt__row">
          <span class="mt__label">{d.speedTitle}</span>
          <strong class="demo-mono">{d.speed}</strong>
          <span class="mt__badge"><Icon name="zap" size={12} />{d.speedOk}</span>
        </div>
      </div>
    </div>
  </div>
  <DemoToggle pause={copy.pause} play={copy.play} />
</div>

<style>
  .mt__status { display: inline-flex; align-items: center; gap: var(--space-2); padding: var(--space-1) var(--space-3); border-radius: var(--radius-pill); background: color-mix(in oklab, var(--lime-1), transparent 85%); color: var(--lime-1); font-size: var(--text-xs); font-weight: var(--weight-strong); white-space: nowrap; }
  .mt__dot { position: relative; width: var(--space-2); height: var(--space-2); border-radius: 50%; background: var(--lime-1); }
  .mt__dot::after { content: ""; position: absolute; inset: 0; border-radius: 50%; background: var(--lime-1); opacity: 0; }
  .mt__body { display: grid; gap: var(--space-4); padding: var(--space-5); }
  @media (min-width: 768px) {
    .mt__body { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  }
  .mt__term { display: grid; align-content: start; gap: var(--space-2); min-height: 17rem; margin: 0; padding: var(--space-5); list-style: none; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--gray-7); font-size: var(--text-sm); }
  .mt__prompt { color: var(--violet-3); }
  .mt__ok { color: var(--lime-1); }
  .mt__done { margin-top: var(--space-2); color: var(--lime-1); }
  .mt__caret { display: inline-block; width: var(--space-2); height: 1em; margin-left: var(--space-1); vertical-align: text-bottom; background: var(--lime-1); }
  .mt__side { display: grid; gap: var(--space-3); align-content: start; }
  .mt__card { padding: var(--space-4); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
  .mt__label { margin: 0 0 var(--space-3); color: var(--color-text-muted); font-size: var(--text-xs); font-weight: var(--weight-strong); letter-spacing: var(--tracking-caps); text-transform: uppercase; }
  .mt__ecg { overflow: hidden; height: var(--space-8); }
  .mt__ecg-svg { display: block; width: 200%; height: 100%; }
  .mt__ecg-svg path { fill: none; stroke: var(--lime-1); stroke-width: 2; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .mt__days { display: grid; grid-template-columns: repeat(30, minmax(0, 1fr)); gap: 2px; height: var(--space-6); }
  .mt__days i { border-radius: 2px; background: var(--lime-1); transform-origin: bottom; }
  .mt__row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .mt__row .mt__label { margin: 0 auto 0 0; }
  .mt__row strong { font-size: var(--text-lg); }
  .mt__badge { display: inline-flex; align-items: center; gap: var(--space-1); padding: 0 var(--space-2); border-radius: var(--radius-pill); background: var(--lime-1); color: var(--lime-7); font-size: var(--text-xs); font-weight: var(--weight-strong); }

  @keyframes mt-ecg { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @keyframes mt-ping { 0% { opacity: 0.7; transform: scale(1); } 60%, 100% { opacity: 0; transform: scale(3); } }
  @keyframes mt-caret { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  @keyframes mt-day { 0%, 6% { transform: scaleY(0); } 12%, 92% { transform: none; } 97%, 100% { transform: scaleY(0); } }
  @keyframes mt-l0 { 0%, 2% { opacity: 0; } 5%, 92% { opacity: 1; } 97%, 100% { opacity: 0; } }
  @keyframes mt-l1 { 0%, 11% { opacity: 0; transform: translateX(calc(var(--space-2) * -1)); } 14%, 92% { opacity: 1; transform: none; } 97%, 100% { opacity: 0; } }
  @keyframes mt-l2 { 0%, 20% { opacity: 0; transform: translateX(calc(var(--space-2) * -1)); } 23%, 92% { opacity: 1; transform: none; } 97%, 100% { opacity: 0; } }
  @keyframes mt-l3 { 0%, 29% { opacity: 0; transform: translateX(calc(var(--space-2) * -1)); } 32%, 92% { opacity: 1; transform: none; } 97%, 100% { opacity: 0; } }
  @keyframes mt-l4 { 0%, 38% { opacity: 0; transform: translateX(calc(var(--space-2) * -1)); } 41%, 92% { opacity: 1; transform: none; } 97%, 100% { opacity: 0; } }
  @keyframes mt-l5 { 0%, 47% { opacity: 0; transform: translateX(calc(var(--space-2) * -1)); } 50%, 92% { opacity: 1; transform: none; } 97%, 100% { opacity: 0; } }
  @keyframes mt-l6 { 0%, 58% { opacity: 0; } 62%, 92% { opacity: 1; } 97%, 100% { opacity: 0; } }
  @media (prefers-reduced-motion: no-preference) {
    .mt__ecg-svg { animation: mt-ecg calc(var(--cycle) / 4) linear infinite both; }
    .mt__dot::after { animation: mt-ping calc(var(--cycle) / 7) var(--ease-out) infinite both; }
    .mt__caret { animation: mt-caret calc(var(--dur-slow) * 2) steps(1) infinite both; }
    .mt__days i { animation: mt-day var(--cycle) var(--ease-out) infinite both; animation-delay: calc(var(--cycle) * 0.004 * var(--i)); }
    .mt__line--0 { animation: mt-l0 var(--cycle) linear infinite both; }
    .mt__line--1 { animation: mt-l1 var(--cycle) var(--ease-out) infinite both; }
    .mt__line--2 { animation: mt-l2 var(--cycle) var(--ease-out) infinite both; }
    .mt__line--3 { animation: mt-l3 var(--cycle) var(--ease-out) infinite both; }
    .mt__line--4 { animation: mt-l4 var(--cycle) var(--ease-out) infinite both; }
    .mt__line--5 { animation: mt-l5 var(--cycle) var(--ease-out) infinite both; }
    .mt__line--6 { animation: mt-l6 var(--cycle) var(--ease-out) infinite both; }
  }
</style>
