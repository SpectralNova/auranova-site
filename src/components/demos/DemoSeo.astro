---
// Posicionamiento en Google: an analyst's dashboard. KPIs count up, the weekly chart draws itself, the
// searches that bring visits climb, and the speed checks pass. EVERY number is sample data and the window
// says so ("Datos de ejemplo"; docs/CLAIMS.md). Numbers are internally consistent: the last 4 weeks of the
// chart add up to the clicks KPI (864) and are 18% above the 4 weeks before (732).
import Icon from '../Icon.astro';
import DemoToggle from '../DemoToggle.astro';

interface Props {
  copy: any;
}

const { copy } = Astro.props;
const d = copy.demo;
const weeks = [172, 178, 186, 196, 200, 210, 220, 234];
const x = (i: number) => 24 + i * 40;
const y = (v: number) => +(104 - ((v - 160) * 84) / 80).toFixed(1);
const line = weeks.map((v, i) => `${i ? 'L' : 'M'}${x(i)} ${y(v)}`).join(' ');
const area = `${line} L${x(weeks.length - 1)} 112 L${x(0)} 112 Z`;
---

<div class="svc-demo demo-dark seo" data-demo>
  <div class="seo__scene" aria-hidden="true">
    <div class="demo-window__bar">
      <span class="demo-window__dots"><span></span><span></span><span></span></span>
      <span class="svc-demo__title"><Icon name="chart-line" size={14} />{d.title}</span>
      <span class="svc-demo__bar-end">
        <span class="seo__period">{d.period}</span>
        <span class="demo-tag">{d.sample}</span>
      </span>
    </div>
    <div class="seo__body">
      <ul class="seo__kpis">
        {
          d.kpis.map((k: any, i: number) => (
            <li class={`seo__kpi seo__kpi--${i + 1}`}>
              <span class="seo__kpi-label">{k.label}</span>
              <span class="seo__kpi-value demo-mono">
                {k.count ? <span class={`seo__count seo__count--${i + 1}`} /> : k.value}
              </span>
              <span class="seo__delta">
                <Icon name="trending-up" size={12} />
                {k.delta}
              </span>
              <span class="seo__mini">
                <i /><i /><i /><i /><i />
              </span>
            </li>
          ))
        }
      </ul>
      <div class="seo__grid">
        <figure class="seo__panel seo__chart">
          <figcaption class="seo__panel-title">{d.chartTitle}</figcaption>
          <div class="seo__plot">
            <svg viewBox="0 0 320 120" preserveAspectRatio="none" class="seo__svg">
              <defs>
                <linearGradient id="seo-area" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" class="seo__stop-a" />
                  <stop offset="1" class="seo__stop-b" />
                </linearGradient>
              </defs>
              {[24, 52, 80, 108].map((gy) => <line x1="0" x2="320" y1={gy} y2={gy} class="seo__gridline" />)}
              <path d={area} fill="url(#seo-area)" />
              <path d={line} class="seo__line" />
              {weeks.map((v, i) => <circle cx={x(i)} cy={y(v)} r="2.6" class:list={['seo__dot', { 'seo__dot--last': i === weeks.length - 1 }]} />)}
            </svg>
            <span class="seo__cover"></span>
            <span class="seo__tip demo-mono">{d.tip}</span>
          </div>
          <div class="seo__axis demo-mono">{d.axis.map((a: string) => <span>{a}</span>)}</div>
        </figure>
        <div class="seo__side">
          <div class="seo__panel">
            <p class="seo__panel-title">{d.queriesTitle}</p>
            <ol class="seo__queries">
              {
                d.queries.map((q: any, i: number) => (
                  <li class={`seo__q seo__q--${i + 1}`}>
                    <span class="seo__pos demo-mono">#{q.pos}</span>
                    <span class="seo__term">{q.term}</span>
                    <span class="seo__up demo-mono"><Icon name="arrow-up" size={12} />{q.up}</span>
                  </li>
                ))
              }
            </ol>
          </div>
          <div class="seo__panel">
            <p class="seo__panel-title">{d.vitalsTitle}</p>
            <ul class="seo__vitals">
              {
                d.vitals.map((v: any, i: number) => (
                  <li class={`seo__vital seo__vital--${i + 1}`}>
                    <span>{v.label}</span>
                    <strong class="demo-mono">{v.value}</strong>
                    <span class="seo__ok"><Icon name="check" size={12} /></span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
  <DemoToggle pause={copy.pause} play={copy.play} />
</div>

<style>
  /* Integer custom properties so the KPI numbers can count up (transform-free, compositor-cheap). */
  @property --seo-n1 { syntax: '<integer>'; inherits: false; initial-value: 0; }
  @property --seo-n3 { syntax: '<integer>'; inherits: false; initial-value: 0; }
  @property --seo-n4 { syntax: '<integer>'; inherits: false; initial-value: 0; }

  .seo__period { padding: var(--space-1) var(--space-3); border-radius: var(--radius-pill); background: var(--color-surface-2); color: var(--color-text-muted); font-size: var(--text-xs); white-space: nowrap; }
  @media (max-width: 767px) {
    .seo__period { display: none; }
  }
  .seo__body { display: grid; gap: var(--space-4); padding: var(--space-5); }
  .seo__kpis { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); margin: 0; padding: 0; list-style: none; }
  @media (min-width: 768px) {
    .seo__kpis { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .seo__kpi { position: relative; display: grid; gap: var(--space-1); padding: var(--space-4); overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
  .seo__kpi-label { color: var(--color-text-muted); font-size: var(--text-xs); }
  .seo__kpi-value { font-size: var(--text-2xl); font-weight: var(--weight-strong); line-height: 1.1; }
  .seo__count--1 { --seo-n1: 864; counter-reset: n1 var(--seo-n1); }
  .seo__count--1::after { content: counter(n1); }
  .seo__count--3 { --seo-n3: 63; counter-reset: n3 var(--seo-n3); }
  .seo__count--3::after { content: counter(n3); }
  .seo__count--4 { --seo-n4: 41; counter-reset: n4 var(--seo-n4); }
  .seo__count--4::after { content: counter(n4); }
  .seo__delta { display: inline-flex; align-items: center; gap: var(--space-1); justify-self: start; padding: 0 var(--space-2); border-radius: var(--radius-pill); background: color-mix(in oklab, var(--lime-1), transparent 85%); color: var(--lime-1); font-size: var(--text-xs); font-weight: var(--weight-strong); }
  .seo__mini { position: absolute; right: var(--space-4); bottom: var(--space-4); display: flex; align-items: flex-end; gap: 2px; height: var(--space-6); }
  .seo__mini i { width: var(--space-1); border-radius: var(--radius-pill); background: var(--violet-4); transform-origin: bottom; }
  .seo__mini i:nth-child(1) { height: 40%; }
  .seo__mini i:nth-child(2) { height: 55%; }
  .seo__mini i:nth-child(3) { height: 50%; }
  .seo__mini i:nth-child(4) { height: 75%; }
  .seo__mini i:nth-child(5) { height: 100%; background: var(--lime-1); }
  .seo__grid { display: grid; gap: var(--space-4); }
  @media (min-width: 768px) {
    .seo__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  }
  .seo__panel { margin: 0; padding: var(--space-4); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
  .seo__panel-title { margin: 0 0 var(--space-3); color: var(--color-text-muted); font-size: var(--text-xs); font-weight: var(--weight-strong); letter-spacing: var(--tracking-caps); text-transform: uppercase; }
  .seo__side { display: grid; gap: var(--space-4); }
  .seo__plot { position: relative; height: 12rem; overflow: hidden; }
  .seo__svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .seo__gridline { stroke: var(--color-border); stroke-width: 1; stroke-dasharray: 3 4; vector-effect: non-scaling-stroke; }
  .seo__stop-a { stop-color: var(--lime-1); stop-opacity: 0.32; }
  .seo__stop-b { stop-color: var(--lime-1); stop-opacity: 0; }
  .seo__line { fill: none; stroke: var(--lime-1); stroke-width: 2.5; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .seo__dot { fill: var(--color-bg); stroke: var(--lime-1); stroke-width: 2; vector-effect: non-scaling-stroke; }
  .seo__dot--last { fill: var(--lime-1); }
  /* Draw-on: a panel-coloured cover slides off to the right (transform only). */
  .seo__cover { position: absolute; inset: 0 0 0 0; background: var(--color-surface); transform-origin: right; transform: scaleX(0); }
  .seo__tip { position: absolute; top: 0; right: 0; padding: var(--space-1) var(--space-2); border-radius: var(--radius-sm); background: var(--lime-1); color: var(--lime-7); font-size: var(--text-xs); font-weight: var(--weight-strong); }
  .seo__axis { display: flex; justify-content: space-between; margin-top: var(--space-2); color: var(--color-text-muted); font-size: var(--text-xs); }
  .seo__queries, .seo__vitals { display: grid; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .seo__q { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: var(--space-3); font-size: var(--text-sm); }
  .seo__pos { min-width: var(--space-7); padding: var(--space-1) var(--space-2); border-radius: var(--radius-sm); background: var(--violet-5); color: var(--violet-1); text-align: center; font-size: var(--text-xs); font-weight: var(--weight-strong); }
  .seo__term { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .seo__up { display: inline-flex; align-items: center; gap: 2px; color: var(--lime-1); font-size: var(--text-xs); }
  .seo__vital { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: center; gap: var(--space-3); font-size: var(--text-sm); }
  .seo__vital strong { font-size: var(--text-sm); }
  .seo__ok { display: inline-grid; place-items: center; width: var(--space-5); height: var(--space-5); border-radius: 50%; background: var(--lime-1); color: var(--lime-7); }

  @keyframes seo-n1 { 0%, 4% { --seo-n1: 0; } 16%, 92% { --seo-n1: 864; } 97%, 100% { --seo-n1: 0; } }
  @keyframes seo-n3 { 0%, 6% { --seo-n3: 0; } 18%, 92% { --seo-n3: 63; } 97%, 100% { --seo-n3: 0; } }
  @keyframes seo-n4 { 0%, 8% { --seo-n4: 0; } 20%, 92% { --seo-n4: 41; } 97%, 100% { --seo-n4: 0; } }
  @keyframes seo-kpi { 0%, 2% { opacity: 0; transform: translateY(var(--space-3)); } 6%, 92% { opacity: 1; transform: none; } 97%, 100% { opacity: 0; } }
  @keyframes seo-mini { 0%, 8% { transform: scaleY(0); } 18%, 92% { transform: scaleY(1); } 97%, 100% { transform: scaleY(0); } }
  @keyframes seo-draw { 0%, 18% { transform: scaleX(1); } 52%, 92% { transform: scaleX(0); } 97%, 100% { transform: scaleX(1); } }
  @keyframes seo-tip { 0%, 52% { opacity: 0; transform: translateY(var(--space-2)); } 56%, 92% { opacity: 1; transform: none; } 97%, 100% { opacity: 0; } }
  @keyframes seo-q { 0%, 26% { opacity: 0; transform: translateY(var(--space-4)); } 33%, 86% { opacity: 1; transform: none; } 91%, 100% { opacity: 0; } }
  @keyframes seo-vital { 0%, 54% { opacity: 0; transform: scale(0.4); } 60%, 86% { opacity: 1; transform: none; } 91%, 100% { opacity: 0; } }
  @media (prefers-reduced-motion: no-preference) {
    .seo__kpi { animation: seo-kpi var(--cycle) var(--ease-out) infinite both; }
    .seo__count--1 { animation: seo-n1 var(--cycle) var(--ease-out) infinite both; }
    .seo__count--3 { animation: seo-n3 var(--cycle) var(--ease-out) infinite both; }
    .seo__count--4 { animation: seo-n4 var(--cycle) var(--ease-out) infinite both; }
    .seo__mini i { animation: seo-mini var(--cycle) var(--ease-out) infinite both; }
    .seo__cover { animation: seo-draw var(--cycle) linear infinite both; }
    .seo__tip { animation: seo-tip var(--cycle) var(--ease-out) infinite both; }
    /* The query rows and checks start a little later each (the cycle is the same, so they stay in step). */
    .seo__q { animation: seo-q var(--cycle) var(--ease-out) infinite both; }
    .seo__q--2 { animation-delay: calc(var(--cycle) * 0.03); }
    .seo__q--3 { animation-delay: calc(var(--cycle) * 0.06); }
    .seo__q--4 { animation-delay: calc(var(--cycle) * 0.09); }
    .seo__vital { animation: seo-vital var(--cycle) var(--ease-out) infinite both; }
    .seo__vital--2 { animation-delay: calc(var(--cycle) * 0.03); }
    .seo__vital--3 { animation-delay: calc(var(--cycle) * 0.06); }
  }
</style>
