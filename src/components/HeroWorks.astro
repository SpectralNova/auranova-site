---
// Home hero visual (CP1.2): "un sitio que trabaja tanto como tú", shown, not told. Three options for David:
//   a · Tu sitio atiende      a business site that takes a quote request while notifications arrive
//   b · Tu sitio no cierra    a phone from day to night, receiving clients at every hour
//   c · Del clic al cliente   search → your site → a new client message
// Illustrative UI (a generic "tunegocio.mx"), no real numbers. Pausable; still for reduced motion.
import Icon from './Icon.astro';
import DemoToggle from './DemoToggle.astro';

interface Props {
  variant: 'a' | 'b' | 'c';
  copy: any;
}

const { variant, copy } = Astro.props;
const a = copy.a;
const b = copy.b;
const c = copy.c;
---

<div class:list={['works', `works--${variant}`]} data-demo>
  <div class="works__scene" aria-hidden="true">
    {
      variant === 'a' && (
        <>
          <div class="demo-window demo-window--light wa-window">
            <div class="demo-window__bar">
              <span class="demo-window__dots">
                <span />
                <span />
                <span />
              </span>
              <span class="demo-window__url">
                <Icon name="lock" size={12} />
                {a.url}
              </span>
            </div>
            <div class="wa-site">
              <div class="wa-nav">
                <span class="wa-logo" />
                <span class="wa-brand">{a.brand}</span>
                <span class="mock-line wa-navline" />
                <span class="mock-line wa-navline" />
                <span class="mock-line wa-navline" />
              </div>
              <div class="wa-hero">
                <span class="mock-line mock-line--strong mock-line--w70" />
                <span class="mock-line mock-line--w50" />
                <span class="wa-cta">
                  {a.cta}
                  <span class="wa-cursor">
                    <Icon name="mouse-pointer-2" size={26} />
                  </span>
                </span>
              </div>
              <div class="wa-cards">
                <span />
                <span />
                <span />
              </div>
              <div class="wa-form">
                <p>{a.formTitle}</p>
                <span class="wa-field wa-field--1" />
                <span class="wa-field wa-field--2" />
                <span class="wa-sent">
                  <Icon name="check" size={14} />
                  {a.sent}
                </span>
              </div>
            </div>
          </div>
          <ul class="wa-toasts">
            {a.toasts.map((t: any, i: number) => (
              <li class:list={['demo-toast', `wa-toast wa-toast--${i + 1}`]}>
                <span class:list={['demo-toast__icon', { 'demo-toast__icon--violet': i === 1 }]}>
                  <Icon name={t.icon} size={18} />
                </span>
                <span>
                  <strong>{t.title}</strong>
                  <small>{t.meta}</small>
                </span>
              </li>
            ))}
          </ul>
        </>
      )
    }

    {
      variant === 'b' && (
        <div class="wb-stage">
          <div class="wb-sky">
            <div class="wb-day" />
            <div class="wb-night" />
            <div class="wb-orbit">
              <span class="wb-sun">
                <Icon name="sun" size={22} />
              </span>
              <span class="wb-moon">
                <Icon name="moon" size={20} />
              </span>
            </div>
          </div>
          <p class="wb-clock">
            {b.events.map((e: any, i: number) => (
              <span class={`wb-time wb-time--${i + 1}`}>{e.time}</span>
            ))}
          </p>
          <div class="wb-phone">
            <div class="wb-screen">
              <span class="demo-window__url wb-url">
                <Icon name="lock" size={12} />
                {b.url}
              </span>
              <ul class="wb-list">
                {b.events.map((e: any, i: number) => (
                  <li class={`wb-note wb-note--${i + 1}`}>
                    <span class="wb-note__icon">
                      <Icon name={e.icon} size={14} />
                    </span>
                    <span>
                      <strong>{e.title}</strong>
                      <small>{e.time}</small>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <span class="wb-badge">
            <Icon name="moon" size={14} />
            {b.badge}
          </span>
        </div>
      )
    }

    {
      variant === 'c' && (
        <ol class="wc-flow">
          <li class="wc-stage wc-stage--1">
            <span class="wc-step">
              <b>01</b> {c.steps[0]}
            </span>
            <div class="wc-card">
              <span class="wc-search">
                <Icon name="search" size={16} />
                <span class="wc-query">{c.query}</span>
              </span>
              <span class="wc-result">
                <span class="wc-pin">
                  <Icon name="map-pin" size={16} />
                </span>
                <span>
                  <strong>{c.result}</strong>
                  <small>{c.resultMeta}</small>
                </span>
              </span>
            </div>
          </li>
          <li class="wc-stage wc-stage--2">
            <span class="wc-dot" />
            <span class="wc-step">
              <b>02</b> {c.steps[1]}
            </span>
            <div class="wc-card wc-card--site">
              <span class="mock-line mock-line--strong mock-line--w70" />
              <span class="mock-line mock-line--w50" />
              <span class="wc-button">{c.cta}</span>
            </div>
          </li>
          <li class="wc-stage wc-stage--3">
            <span class="wc-dot" />
            <span class="wc-step">
              <b>03</b> {c.steps[2]}
            </span>
            <div class="wc-card wc-card--msg">
              <span class="demo-toast__icon">
                <Icon name="send" size={16} />
              </span>
              <span>
                <strong>{c.message}</strong>
                <small>{c.messageText}</small>
              </span>
              <span class="wc-check">
                <Icon name="check" size={14} />
              </span>
            </div>
          </li>
        </ol>
      )
    }
  </div>
  <DemoToggle pause={copy.pause} play={copy.play} />
</div>

<style>
  .works { width: min(100%, 34rem); margin-inline: auto; --cycle: calc(var(--dur-slow) * 24); }

  /* ---------- A · Tu sitio atiende ---------- */
  .works--a .works__scene { padding-bottom: var(--space-9); }
  .wa-window { width: 92%; }
  .wa-site { position: relative; display: grid; gap: var(--space-3); padding: var(--space-4); color: var(--gray-7); }
  .wa-nav { display: flex; align-items: center; gap: var(--space-2); }
  .wa-logo { width: var(--space-4); height: var(--space-4); border-radius: 50%; background: var(--violet-5); }
  .wa-brand { margin-right: auto; font-size: var(--text-xs); font-weight: var(--weight-strong); }
  .wa-navline { width: var(--space-6); }
  .wa-hero { display: grid; gap: var(--space-2); padding: var(--space-5) var(--space-4); border-radius: var(--radius-md); background: linear-gradient(135deg, var(--violet-2), var(--violet-1)); color: var(--violet-7); }
  .wa-cta { position: relative; justify-self: start; margin-top: var(--space-2); padding: var(--space-2) var(--space-4); border-radius: var(--radius-pill); background: var(--gray-7); color: var(--lime-1); font-size: var(--text-xs); font-weight: var(--weight-strong); }
  .wa-cursor { position: absolute; left: 60%; top: 55%; color: var(--gray-7); opacity: 0; }
  .wa-cursor :global(svg) { fill: var(--white); }
  .wa-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-2); }
  .wa-cards span { height: 3.5rem; border: 1px solid var(--gray-1); border-radius: var(--radius-sm); background: var(--white); }
  .wa-form { position: absolute; right: var(--space-4); bottom: var(--space-4); width: 60%; padding: var(--space-4); border-radius: var(--radius-md); background: var(--white); box-shadow: var(--shadow-lg); opacity: 0; }
  .wa-form p { margin: 0 0 var(--space-2); font-size: var(--text-xs); font-weight: var(--weight-strong); }
  .wa-field { position: relative; display: block; height: var(--space-5); margin-bottom: var(--space-2); overflow: hidden; border: 1px solid var(--gray-2); border-radius: var(--radius-sm); }
  .wa-field::after { content: ""; position: absolute; left: var(--space-2); top: 50%; width: 60%; height: var(--space-1); margin-top: calc(var(--space-1) / -2); border-radius: var(--radius-pill); background: var(--gray-4); transform-origin: left; }
  .wa-field--2::after { width: 40%; }
  .wa-sent { display: inline-flex; align-items: center; gap: var(--space-1); padding: var(--space-1) var(--space-3); border-radius: var(--radius-pill); background: var(--lime-1); color: var(--lime-7); font-size: var(--text-xs); font-weight: var(--weight-strong); }
  .wa-toasts { position: absolute; right: 0; bottom: 0; display: grid; gap: var(--space-2); width: min(72%, 19rem); margin: 0; padding: 0; list-style: none; }

  @keyframes wa-cursor { 0% { opacity: 0; transform: translate(7rem, 5rem); } 6% { opacity: 1; } 16% { transform: translate(0, 0); } 18% { transform: translate(0, 0) scale(0.8); } 20% { transform: translate(0, 0) scale(1); } 30% { opacity: 1; } 36%, 100% { opacity: 0; transform: translate(0, 0); } }
  @keyframes wa-press { 0%, 17% { transform: none; } 18.5% { transform: scale(0.92); } 20%, 100% { transform: none; } }
  @keyframes wa-form { 0%, 20% { opacity: 0; transform: translateY(var(--space-4)); } 24%, 86% { opacity: 1; transform: none; } 92%, 100% { opacity: 0; transform: translateY(var(--space-2)); } }
  @keyframes wa-type1 { 0%, 25% { transform: scaleX(0); } 33%, 100% { transform: scaleX(1); } }
  @keyframes wa-type2 { 0%, 33% { transform: scaleX(0); } 40%, 100% { transform: scaleX(1); } }
  @keyframes wa-sent { 0%, 41% { opacity: 0; transform: scale(0.6); } 44%, 86% { opacity: 1; transform: none; } 92%, 100% { opacity: 0; } }
  @keyframes wa-toast1 { 0%, 44% { opacity: 0; transform: translateX(var(--space-6)); } 48%, 90% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; } }
  @keyframes wa-toast2 { 0%, 58% { opacity: 0; transform: translateX(var(--space-6)); } 62%, 90% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; } }
  @keyframes wa-toast3 { 0%, 72% { opacity: 0; transform: translateX(var(--space-6)); } 76%, 90% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; } }
  @media (prefers-reduced-motion: no-preference) {
    .wa-cursor { animation: wa-cursor var(--cycle) var(--ease-out) infinite both; }
    .wa-cta { animation: wa-press var(--cycle) linear infinite both; }
    .wa-form { animation: wa-form var(--cycle) var(--ease-out) infinite both; }
    .wa-field--1::after { animation: wa-type1 var(--cycle) linear infinite both; }
    .wa-field--2::after { animation: wa-type2 var(--cycle) linear infinite both; }
    .wa-sent { animation: wa-sent var(--cycle) var(--ease-out) infinite both; }
    .wa-toast--1 { animation: wa-toast1 var(--cycle) var(--ease-out) infinite both; }
    .wa-toast--2 { animation: wa-toast2 var(--cycle) var(--ease-out) infinite both; }
    .wa-toast--3 { animation: wa-toast3 var(--cycle) var(--ease-out) infinite both; }
  }

  /* ---------- B · Tu sitio no cierra ---------- */
  .works--b { --cycle: calc(var(--dur-slow) * 32); }
  .wb-stage { position: relative; display: grid; justify-items: center; gap: var(--space-4); padding: var(--space-6) 0 var(--space-5); }
  .wb-sky { position: absolute; inset: 0 0 22% 0; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-xl); }
  .wb-day, .wb-night { position: absolute; inset: 0; }
  .wb-day { background: radial-gradient(circle at 50% 115%, color-mix(in oklab, var(--lime-1), transparent 65%), transparent 60%), linear-gradient(180deg, color-mix(in oklab, var(--violet-4), var(--gray-7) 45%), var(--gray-7)); }
  /* Still frame (reduced motion) = 02:10 at night: night sky on, the moon up beside the clock. */
  .wb-night { background: radial-gradient(circle at 50% 115%, color-mix(in oklab, var(--violet-5), transparent 55%), transparent 60%), linear-gradient(180deg, var(--violet-7), var(--gray-7)); }
  .wb-orbit { position: absolute; left: 50%; top: 18%; width: 150%; aspect-ratio: 1; margin-left: -75%; transform: rotate(200deg); }
  .wb-sun, .wb-moon { position: absolute; left: 50%; display: inline-grid; place-items: center; width: var(--space-7); height: var(--space-7); margin-left: calc(var(--space-7) / -2); border-radius: 50%; }
  .wb-sun { top: 0; background: var(--lime-1); color: var(--lime-7); box-shadow: var(--glow-accent); }
  .wb-moon { bottom: 0; background: var(--violet-2); color: var(--violet-7); }
  .wb-clock { position: relative; display: grid; margin: 0; font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--text-3xl); line-height: 1; font-variant-numeric: tabular-nums; }
  .wb-time { grid-area: 1 / 1; opacity: 0; }
  .wb-time--4 { opacity: 1; }
  .wb-phone { position: relative; width: 14rem; padding: var(--space-2); border-radius: var(--radius-xl); background: var(--gray-6); box-shadow: var(--shadow-lg), var(--glow-secondary); }
  .wb-screen { display: grid; align-content: start; gap: var(--space-2); min-height: 17rem; padding: var(--space-3); border-radius: var(--radius-lg); background: var(--violet-1); color: var(--gray-7); }
  .wb-url { justify-self: center; flex: none; margin: 0; background: var(--gray-1); color: var(--gray-5); }
  .wb-list { display: grid; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .wb-note { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-2); border: 1px solid var(--gray-1); border-radius: var(--radius-md); background: var(--white); font-size: var(--text-xs); line-height: 1.3; }
  .wb-note strong { display: block; }
  .wb-note small { color: var(--gray-5); }
  .wb-note__icon { display: inline-grid; place-items: center; flex: none; width: var(--space-6); height: var(--space-6); border-radius: var(--radius-sm); background: var(--violet-5); color: var(--violet-1); }
  .wb-badge { position: absolute; left: 0; bottom: 18%; display: inline-flex; align-items: center; gap: var(--space-2); padding: var(--space-2) var(--space-4); border-radius: var(--radius-pill); background: var(--lime-1); color: var(--lime-7); font-size: var(--text-sm); font-weight: var(--weight-strong); box-shadow: var(--shadow-lg); }

  @keyframes wb-night { 0%, 38% { opacity: 0; } 50%, 88% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes wb-orbit { from { transform: rotate(-35deg); } to { transform: rotate(325deg); } }
  @keyframes wb-t1 { 0%, 22% { opacity: 1; } 25%, 97% { opacity: 0; } 100% { opacity: 1; } }
  @keyframes wb-t2 { 0%, 22% { opacity: 0; } 25%, 47% { opacity: 1; } 50%, 100% { opacity: 0; } }
  @keyframes wb-t3 { 0%, 47% { opacity: 0; } 50%, 72% { opacity: 1; } 75%, 100% { opacity: 0; } }
  @keyframes wb-t4 { 0%, 72% { opacity: 0; } 75%, 97% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes wb-n1 { 0%, 3% { opacity: 0; transform: translateY(calc(var(--space-3) * -1)); } 6%, 94% { opacity: 1; transform: none; } 99%, 100% { opacity: 0; } }
  @keyframes wb-n2 { 0%, 28% { opacity: 0; transform: translateY(calc(var(--space-3) * -1)); } 31%, 94% { opacity: 1; transform: none; } 99%, 100% { opacity: 0; } }
  @keyframes wb-n3 { 0%, 53% { opacity: 0; transform: translateY(calc(var(--space-3) * -1)); } 56%, 94% { opacity: 1; transform: none; } 99%, 100% { opacity: 0; } }
  @keyframes wb-n4 { 0%, 78% { opacity: 0; transform: translateY(calc(var(--space-3) * -1)); } 81%, 94% { opacity: 1; transform: none; } 99%, 100% { opacity: 0; } }
  @media (prefers-reduced-motion: no-preference) {
    .wb-night { animation: wb-night var(--cycle) linear infinite both; }
    .wb-orbit { animation: wb-orbit var(--cycle) linear infinite both; }
    .wb-time--1 { animation: wb-t1 var(--cycle) linear infinite both; }
    .wb-time--2 { animation: wb-t2 var(--cycle) linear infinite both; }
    .wb-time--3 { animation: wb-t3 var(--cycle) linear infinite both; }
    .wb-time--4 { animation: wb-t4 var(--cycle) linear infinite both; }
    .wb-note--1 { animation: wb-n1 var(--cycle) var(--ease-out) infinite both; }
    .wb-note--2 { animation: wb-n2 var(--cycle) var(--ease-out) infinite both; }
    .wb-note--3 { animation: wb-n3 var(--cycle) var(--ease-out) infinite both; }
    .wb-note--4 { animation: wb-n4 var(--cycle) var(--ease-out) infinite both; }
  }

  /* ---------- C · Del clic al cliente ---------- */
  .wc-flow { --gap: var(--space-7); display: grid; gap: var(--gap); margin: 0; padding: 0 0 var(--space-7); list-style: none; }
  .wc-stage { position: relative; width: 84%; }
  .wc-stage--2 { justify-self: end; }
  .wc-stage + .wc-stage::before { content: ""; position: absolute; left: 50%; bottom: 100%; height: var(--gap); border-left: 2px dashed var(--color-border-strong); }
  .wc-dot { position: absolute; left: 50%; bottom: 100%; width: var(--space-3); height: var(--space-3); margin: 0 0 calc(var(--gap) - var(--space-3)) calc(var(--space-3) / -2 + 1px); border-radius: 50%; background: var(--lime-1); box-shadow: var(--glow-accent); opacity: 0; }
  .wc-step { display: inline-flex; gap: var(--space-2); margin-bottom: var(--space-2); color: var(--color-text-muted); font-size: var(--text-xs); font-weight: var(--weight-strong); letter-spacing: var(--tracking-caps); text-transform: uppercase; }
  .wc-step b { color: var(--color-accent); }
  .wc-card { position: relative; display: grid; gap: var(--space-2); padding: var(--space-4); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); box-shadow: var(--shadow-lg); }
  .wc-card::after { content: ""; position: absolute; inset: -1px; border: 1px solid var(--lime-1); border-radius: inherit; box-shadow: var(--glow-accent); opacity: 0; pointer-events: none; }
  .wc-search { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-2) var(--space-3); border-radius: var(--radius-pill); background: var(--color-surface-2); font-size: var(--text-sm); }
  .wc-query { position: relative; overflow: hidden; white-space: nowrap; }
  .wc-query::after { content: ""; position: absolute; inset: 0; background: var(--color-surface-2); transform: translateX(101%); }
  .wc-result { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-2) var(--space-3); border-radius: var(--radius-md); background: color-mix(in oklab, var(--lime-1), transparent 92%); font-size: var(--text-sm); line-height: 1.3; }
  .wc-result strong, .wc-card--msg strong { display: block; }
  .wc-result small, .wc-card--msg small { color: var(--color-text-muted); font-size: var(--text-xs); }
  .wc-pin { display: inline-grid; place-items: center; width: var(--space-6); height: var(--space-6); border-radius: 50%; background: var(--lime-1); color: var(--lime-7); }
  .wc-card--site { color: var(--color-text); }
  .wc-button { justify-self: start; margin-top: var(--space-2); padding: var(--space-2) var(--space-4); border-radius: var(--radius-pill); background: var(--lime-1); color: var(--lime-7); font-size: var(--text-xs); font-weight: var(--weight-strong); }
  .wc-card--msg { grid-template-columns: auto 1fr auto; align-items: center; font-size: var(--text-sm); line-height: 1.3; }
  .wc-check { display: inline-grid; place-items: center; width: var(--space-5); height: var(--space-5); border-radius: 50%; background: var(--lime-1); color: var(--lime-7); }

  @keyframes wc-type { 0%, 3% { transform: translateX(0); } 18%, 96% { transform: translateX(101%); } 100% { transform: translateX(0); } }
  @keyframes wc-result { 0%, 18% { opacity: 0; transform: scale(0.96); } 22%, 92% { opacity: 1; transform: none; } 97%, 100% { opacity: 0; } }
  @keyframes wc-ring1 { 0%, 2% { opacity: 0; } 5%, 30% { opacity: 1; } 34%, 100% { opacity: 0; } }
  @keyframes wc-ring2 { 0%, 40% { opacity: 0; } 43%, 64% { opacity: 1; } 68%, 100% { opacity: 0; } }
  @keyframes wc-ring3 { 0%, 74% { opacity: 0; } 77%, 94% { opacity: 1; } 98%, 100% { opacity: 0; } }
  @keyframes wc-dot1 { 0%, 30% { opacity: 0; transform: translateY(calc(var(--gap) * -1 + var(--space-3))); } 32% { opacity: 1; transform: translateY(calc(var(--gap) * -1 + var(--space-3))); } 40% { opacity: 1; transform: translateY(0); } 41%, 100% { opacity: 0; transform: translateY(0); } }
  @keyframes wc-dot2 { 0%, 64% { opacity: 0; transform: translateY(calc(var(--gap) * -1 + var(--space-3))); } 66% { opacity: 1; transform: translateY(calc(var(--gap) * -1 + var(--space-3))); } 74% { opacity: 1; transform: translateY(0); } 75%, 100% { opacity: 0; transform: translateY(0); } }
  @keyframes wc-press { 0%, 52% { transform: none; } 54% { transform: scale(0.92); } 56%, 100% { transform: none; } }
  @keyframes wc-msg { 0%, 75% { opacity: 0; transform: translateY(var(--space-3)); } 79%, 92% { opacity: 1; transform: none; } 97%, 100% { opacity: 0; } }
  @keyframes wc-check { 0%, 82% { transform: scale(0); } 85%, 94% { transform: scale(1); } 98%, 100% { transform: scale(0); } }
  @media (prefers-reduced-motion: no-preference) {
    .wc-query::after { animation: wc-type var(--cycle) steps(18) infinite both; }
    .wc-result { animation: wc-result var(--cycle) var(--ease-out) infinite both; }
    .wc-stage--1 .wc-card::after { animation: wc-ring1 var(--cycle) linear infinite both; }
    .wc-stage--2 .wc-card::after { animation: wc-ring2 var(--cycle) linear infinite both; }
    .wc-stage--3 .wc-card::after { animation: wc-ring3 var(--cycle) linear infinite both; }
    .wc-stage--2 .wc-dot { animation: wc-dot1 var(--cycle) var(--ease-out) infinite both; }
    .wc-stage--3 .wc-dot { animation: wc-dot2 var(--cycle) var(--ease-out) infinite both; }
    .wc-button { animation: wc-press var(--cycle) linear infinite both; }
    .wc-card--msg { animation: wc-msg var(--cycle) var(--ease-out) infinite both; }
    .wc-check { animation: wc-check var(--cycle) var(--ease-out) infinite both; }
  }
</style>
