---
// Home hero visual (CP1.2): "un sitio que trabaja tanto como tú", shown, not told. David picked option A
// (Q34): a business site takes a quote request while notifications arrive (quote, appointment, message).
// Illustrative UI (a generic "tunegocio.mx"), no real numbers. Pausable; still for reduced motion.
import Icon from './Icon.astro';
import DemoToggle from './DemoToggle.astro';

interface Props {
  copy: any;
}

const { copy } = Astro.props;
const a = copy.a;
---

<div class="works" data-demo>
  <div class="works__scene" aria-hidden="true">
    <div class="demo-window demo-window--light wa-window">
      <div class="demo-window__bar">
        <span class="demo-window__dots">
          <span />
          <span />
          <span />
        </span>
        <span class="demo-window__url">
          <Icon name="lock" size={12} />
          {a.url}
        </span>
      </div>
      <div class="wa-site">
        <div class="wa-nav">
          <span class="wa-logo" />
          <span class="wa-brand">{a.brand}</span>
          <span class="mock-line wa-navline" />
          <span class="mock-line wa-navline" />
          <span class="mock-line wa-navline" />
        </div>
        <div class="wa-hero">
          <span class="mock-line mock-line--strong mock-line--w70" />
          <span class="mock-line mock-line--w50" />
          <span class="wa-cta">
            {a.cta}
            <span class="wa-cursor">
              <Icon name="mouse-pointer-2" size={26} />
            </span>
          </span>
        </div>
        <div class="wa-cards">
          <span />
          <span />
          <span />
        </div>
        <div class="wa-form">
          <p>{a.formTitle}</p>
          <span class="wa-field wa-field--1" />
          <span class="wa-field wa-field--2" />
          <span class="wa-sent">
            <Icon name="check" size={14} />
            {a.sent}
          </span>
        </div>
      </div>
    </div>
    <ul class="wa-toasts">
      {a.toasts.map((t: any, i: number) => (
        <li class:list={['demo-toast', `wa-toast wa-toast--${i + 1}`]}>
          <span class:list={['demo-toast__icon', { 'demo-toast__icon--violet': i === 1 }]}>
            <Icon name={t.icon} size={18} />
          </span>
          <span>
            <strong>{t.title}</strong>
            <small>{t.meta}</small>
          </span>
        </li>
      ))}
    </ul>
  </div>
  <DemoToggle pause={copy.pause} play={copy.play} />
</div>

<style>
  .works { width: min(100%, 34rem); margin-inline: auto; --cycle: calc(var(--dur-slow) * 24); }
  .works__scene { padding-bottom: var(--space-9); }
  .wa-window { width: 92%; }
  .wa-site { position: relative; display: grid; gap: var(--space-3); padding: var(--space-4); color: var(--gray-7); }
  .wa-nav { display: flex; align-items: center; gap: var(--space-2); }
  .wa-logo { width: var(--space-4); height: var(--space-4); border-radius: 50%; background: var(--violet-5); }
  .wa-brand { margin-right: auto; font-size: var(--text-xs); font-weight: var(--weight-strong); }
  .wa-navline { width: var(--space-6); }
  .wa-hero { display: grid; gap: var(--space-2); padding: var(--space-5) var(--space-4); border-radius: var(--radius-md); background: linear-gradient(135deg, var(--violet-2), var(--violet-1)); color: var(--violet-7); }
  .wa-cta { position: relative; justify-self: start; margin-top: var(--space-2); padding: var(--space-2) var(--space-4); border-radius: var(--radius-pill); background: var(--gray-7); color: var(--lime-1); font-size: var(--text-xs); font-weight: var(--weight-strong); }
  .wa-cursor { position: absolute; left: 60%; top: 55%; color: var(--gray-7); opacity: 0; }
  .wa-cursor :global(svg) { fill: var(--white); }
  .wa-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-2); }
  .wa-cards span { height: 3.5rem; border: 1px solid var(--gray-1); border-radius: var(--radius-sm); background: var(--white); }
  .wa-form { position: absolute; right: var(--space-4); bottom: var(--space-4); width: 60%; padding: var(--space-4); border-radius: var(--radius-md); background: var(--white); box-shadow: var(--shadow-lg); opacity: 0; }
  .wa-form p { margin: 0 0 var(--space-2); font-size: var(--text-xs); font-weight: var(--weight-strong); }
  .wa-field { position: relative; display: block; height: var(--space-5); margin-bottom: var(--space-2); overflow: hidden; border: 1px solid var(--gray-2); border-radius: var(--radius-sm); }
  .wa-field::after { content: ""; position: absolute; left: var(--space-2); top: 50%; width: 60%; height: var(--space-1); margin-top: calc(var(--space-1) / -2); border-radius: var(--radius-pill); background: var(--gray-4); transform-origin: left; }
  .wa-field--2::after { width: 40%; }
  .wa-sent { display: inline-flex; align-items: center; gap: var(--space-1); padding: var(--space-1) var(--space-3); border-radius: var(--radius-pill); background: var(--lime-1); color: var(--lime-7); font-size: var(--text-xs); font-weight: var(--weight-strong); }
  .wa-toasts { position: absolute; right: 0; bottom: 0; display: grid; gap: var(--space-2); width: min(72%, 19rem); margin: 0; padding: 0; list-style: none; }

  @keyframes wa-cursor { 0% { opacity: 0; transform: translate(7rem, 5rem); } 6% { opacity: 1; } 16% { transform: translate(0, 0); } 18% { transform: translate(0, 0) scale(0.8); } 20% { transform: translate(0, 0) scale(1); } 30% { opacity: 1; } 36%, 100% { opacity: 0; transform: translate(0, 0); } }
  @keyframes wa-press { 0%, 17% { transform: none; } 18.5% { transform: scale(0.92); } 20%, 100% { transform: none; } }
  @keyframes wa-form { 0%, 20% { opacity: 0; transform: translateY(var(--space-4)); } 24%, 86% { opacity: 1; transform: none; } 92%, 100% { opacity: 0; transform: translateY(var(--space-2)); } }
  @keyframes wa-type1 { 0%, 25% { transform: scaleX(0); } 33%, 100% { transform: scaleX(1); } }
  @keyframes wa-type2 { 0%, 33% { transform: scaleX(0); } 40%, 100% { transform: scaleX(1); } }
  @keyframes wa-sent { 0%, 41% { opacity: 0; transform: scale(0.6); } 44%, 86% { opacity: 1; transform: none; } 92%, 100% { opacity: 0; } }
  @keyframes wa-toast1 { 0%, 44% { opacity: 0; transform: translateX(var(--space-6)); } 48%, 90% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; } }
  @keyframes wa-toast2 { 0%, 58% { opacity: 0; transform: translateX(var(--space-6)); } 62%, 90% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; } }
  @keyframes wa-toast3 { 0%, 72% { opacity: 0; transform: translateX(var(--space-6)); } 76%, 90% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; } }
  @media (prefers-reduced-motion: no-preference) {
    .wa-cursor { animation: wa-cursor var(--cycle) var(--ease-out) infinite both; }
    .wa-cta { animation: wa-press var(--cycle) linear infinite both; }
    .wa-form { animation: wa-form var(--cycle) var(--ease-out) infinite both; }
    .wa-field--1::after { animation: wa-type1 var(--cycle) linear infinite both; }
    .wa-field--2::after { animation: wa-type2 var(--cycle) linear infinite both; }
    .wa-sent { animation: wa-sent var(--cycle) var(--ease-out) infinite both; }
    .wa-toast--1 { animation: wa-toast1 var(--cycle) var(--ease-out) infinite both; }
    .wa-toast--2 { animation: wa-toast2 var(--cycle) var(--ease-out) infinite both; }
    .wa-toast--3 { animation: wa-toast3 var(--cycle) var(--ease-out) infinite both; }
  }
</style>
