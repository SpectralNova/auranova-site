---
// A huge row of capability names that slides sideways while the section crosses the screen (motion.css,
// scroll-linked: it moves only when the visitor scrolls). Decorative: the real list is the grid below it.
interface Props {
  items: string[];
}

const { items } = Astro.props;
const row = [...items, ...items];
---

<div class="ticker" aria-hidden="true">
  <p class="ticker__row sd-slide">
    {
      row.map((item, i) => (
        <span class:list={['ticker__item', { 'ticker__item--hl': i % 3 === 1 }]}>{item}</span>
      ))
    }
  </p>
</div>

<style>
  /* Full width, plain text (David, CP1.2 review: no fades): the row starts on the content column and runs
     off the screen edges. The section clips the 100vw overflow (.section--ticker). */
  .ticker { overflow: hidden; margin: 0 calc(50% - 50vw) var(--space-8); padding: var(--space-2) calc(50vw - 50%); }
  .ticker__row {
    --sd-x-from: 0%; --sd-x-to: -35%;
    display: flex; gap: var(--space-6); width: max-content; margin: 0;
    font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--text-4xl); line-height: 1.1; letter-spacing: var(--tracking-display); white-space: nowrap;
  }
  .ticker__item { display: inline-flex; align-items: center; gap: var(--space-6); color: var(--color-text-muted); }
  .ticker__item::after { content: "✦"; color: var(--color-border-strong); font-size: var(--text-xl); }
  .ticker__item--hl { color: var(--color-accent); }
  .theme-light .ticker__item--hl { color: var(--color-link); }
</style>
