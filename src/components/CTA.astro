---
// The primary call to action (ADR-004). Always goes to the booking block on the contact page, which offers
// Cal.com or an email (David, 2026-10-20).
import type { Lang } from '../content/business';
import { href } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Where the CTA sits, for the cta_click event (hero, final, nav…). */
  location: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const { lang, location, variant = 'primary', class: className } = Astro.props;
const url = `${href('contacto', lang)}#agenda`;
---

<a
  class:list={['btn', `btn--${variant}`, className]}
  href={url}
  data-track="cta_click"
  data-track-location={location}>{t(lang).cta}</a
>
