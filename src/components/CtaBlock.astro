---
// The closing call to action, inside a page's last section (CP1.2: the violet band is retired, ADR-010).
// Optional title line, the primary button, and a short note under it.
import CTA from './CTA.astro';
import { rich } from '../lib/rich';
import { t } from '../i18n/ui';
import type { Lang } from '../content/business';

interface Props {
  lang: Lang;
  location?: string;
  title?: string;
  note?: string;
  center?: boolean;
}

const { lang, location = 'final', title, note = t(lang).ctaNote, center = false } = Astro.props;
---

<div class:list={['cta-block', { 'cta-block--center': center, 'cta-block--titled': title }]}>
  {title && <p class="cta-block__title" set:html={rich(title, lang)} />}
  <CTA lang={lang} location={location} />
  <p class="cta-block__note" set:html={rich(note, lang)} />
</div>

<style>
  .cta-block { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3); margin-top: var(--space-7); }
  .cta-block--center { align-items: center; text-align: center; }
  .cta-block--titled { margin-top: var(--space-8); padding-top: var(--space-7); border-top: 1px solid var(--color-border); }
  .cta-block__title { margin: 0 0 var(--space-2); max-width: 24ch; font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--text-3xl); line-height: var(--leading-tight); letter-spacing: var(--tracking-display); }
  .cta-block__note { margin: 0; color: var(--color-text-muted); font-size: var(--text-sm); }
</style>
