---
// The six services as cards with their 2D illustration; each links to its own page.
// The illustration style is one setting (`illustration` in pages/<lang>/servicios.yaml); /opciones/ compares them.
import { getCollection, getEntry } from 'astro:content';
import GeneratedImage from './GeneratedImage.astro';
import { href, type RouteKey } from '../i18n/routes';
import type { Lang } from '../content/business';

interface Props {
  lang: Lang;
  linkLabel: string;
  /** Override the site-wide illustration style (only /opciones/ does this). */
  style?: 'a' | 'b' | 'c';
}

const { lang, linkLabel } = Astro.props;
const shared = (await getEntry('pages', `${lang}/servicios`))?.data as { illustration?: 'a' | 'b' | 'c' } | undefined;
const style = Astro.props.style ?? shared?.illustration ?? 'a';
const services = (await getCollection('services', (s) => s.id.startsWith(`${lang}/`))).sort((a, b) => a.data.order - b.data.order);
---

<ul class:list={['card-grid card-grid--3', `svc-grid svc-grid--${style}`]} role="list">
  {
    services.map(({ data }) => (
      <li class="card card--interactive svc-card">
        <div class="svc-card__art">
          <GeneratedImage file={`services/${style}/${data.art}.webp`} widths={[208, 312, 416]} sizes="13rem" />
        </div>
        <span class="tag">{data.kicker}</span>
        <h3 class="card__title">
          <a class="card__link" href={href(data.route as RouteKey, lang)}>
            {data.name}
          </a>
        </h3>
        <p class="muted">{data.summary}</p>
        <span class="svc-card__more" aria-hidden="true">
          {linkLabel} →
        </span>
      </li>
    ))
  }
</ul>
