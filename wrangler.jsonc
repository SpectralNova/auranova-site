// Cloudflare Worker that only serves the static build (ADR-002). No server code, no adapter:
// with this file present, `wrangler deploy` uploads dist/ as-is instead of auto-configuring the project.
// _headers (CSP, noindex on previews…) in dist/ is applied by Cloudflare's static assets.
{
  "name": "auranova-site",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash"
  }
}
