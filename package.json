{
  "name": "auranova-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-pending.mjs",
    "preview": "astro preview",
    "sync:ds": "node scripts/sync-design-system.mjs",
    "check:pending": "node scripts/check-pending.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test:a11y": "playwright test",
    "test:lh": "node scripts/lighthouse.mjs",
    "measure": "node scripts/lighthouse.mjs --write-scores",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.1",
    "lucide-static": "^1.59.0",
    "simple-icons": "^16.35.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^13.5.0",
    "typescript": "^6.0.3"
  }
}
